{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/shop/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    },
    {
      "src": "artifacts/api-server/src/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**",
          "artifacts/api-server/src/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/artifacts/api-server/src/vercel.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/shop/dist/public/$1"
    }
  ]
}
